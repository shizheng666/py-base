# 项目名称，会显示在 FastAPI 文档页标题里。
APP_NAME=Task Collaboration API

# 教学环境默认使用 SQLite 内存数据库。
# 真正做持久化时，可以改成 sqlite:///./task_collab.db 或 PostgreSQL 连接串。
DATABASE_URL=sqlite+pysqlite:///:memory:

# 这个值暂时是为模块 11 预留的，后续引入 Redis / Celery 时会用到。
REDIS_URL=redis://localhost:6379/0

# JWT 签名密钥。开发环境可以先用简单值，生产环境必须换成随机强密钥。
JWT_SECRET_KEY=dev-secret-key-change-me-at-least-32

# 异步通知日志输出路径。模块 11 会把后台通知以 JSONL 的形式写到这里。
NOTIFICATION_LOG_PATH=projects/task_collab_api/runtime/notifications.jsonl

# 调试模式在开发环境很有用，生产环境通常应关闭。
DEBUG=true
